{
  "name": "playverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PLAYVERSE — online browser gaming platform (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w @playverse/api\" \"npm run dev -w @playverse/web\"",
    "build": "npm run build -w @playverse/api && npm run build -w @playverse/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:games": "playwright test --project=games-smoke --project=games-smoke-mobile",
    "games:publish": "tsx scripts/publish-verified-games.ts",
    "infra:up": "docker compose up -d postgres redis mailpit",
    "infra:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "catalog:docs": "tsx scripts/generate-catalog-docs.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "dotenv": "^17.4.2",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "vite": "^7.3.7",
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
