# ---------------------------------------------------------------------------
# PLAYVERSE environment configuration
# Copy to `.env` for local development:   copy .env.example .env   (Windows)
#                                          cp .env.example .env     (macOS/Linux)
# Never commit a real `.env`. Production values must come from your secret store.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API -------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app, used to build links in emails
APP_URL=http://localhost:5173
# Set to the number of trusted reverse-proxy hops (e.g. 1 behind Nginx). 0 = trust none.
TRUST_PROXY=0
LOG_LEVEL=info
# Scales the general API and gameplay rate limits (1-100). Login, registration and token limits never scale.
# Raise it (e.g. 10) only for automated runs such as the all-games smoke test.
RATE_LIMIT_MULTIPLIER=1

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_HOURS=168
# Cookies are always Secure when NODE_ENV=production. Set true locally only if you serve over HTTPS.
COOKIE_SECURE=false

# --- PostgreSQL (docker compose maps the container to host port 5433) -------
POSTGRES_USER=playverse
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=playverse
DATABASE_URL=postgresql://playverse:change_me_local_only@127.0.0.1:5433/playverse?schema=public
# Separate database used by the automated API tests (created by docker/postgres/init.sql)
TEST_DATABASE_URL=postgresql://playverse:change_me_local_only@127.0.0.1:5433/playverse_test?schema=public

# --- Redis (optional; rate limiting falls back to in-memory when empty) -----
REDIS_URL=redis://127.0.0.1:6380

# --- Email ------------------------------------------------------------------
# Local development uses Mailpit (web UI: http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PLAYVERSE <no-reply@playverse.local>"

# --- Seeding ------------------------------------------------------------------
# Optional. When BOTH are set, `npm run db:seed` creates/promotes this account to ADMIN.
# No default administrator is ever created. Use a unique, strong password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
